  "prisma migrate dev",
  "vercel deploy --prod",
  "npm run deploy",
  "fly deploy -a yaadbooks",
  "git push origin main",
  "kubectl apply -f *",
  "terraform apply",
  "psql * -c *",
  "c++ -o app",
  "node scripts/deploy.mjs"
 ],
 "invalid": [
