  },
  {
   "pattern": "* deploy",
   "error_contains": "first token"
  },
  {
   "pattern": "supabase db push.*",
   "error_contains": "whole token"
  },
  {
   "pattern": "vercel*",
   "error_contains": "whole token"
  },
  {
