  },
  {
   "pattern": "rm -rf $HOME",
   "error_contains": "no regex"
  },
  {
   "pattern": "echo 'x'",
   "error_contains": "no regex"
  },
  {
   "pattern": "a a a a a a a a a a a a a a a a a",
   "error_contains": "16 tokens"
  },
  {
   "pattern": "a ",
   "error_contains": "256 chars"
  },
  {
   "pattern": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
   "error_contains": "no regex"
  }
 ],
