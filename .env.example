# =============================================================================
# Remembra Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your deployment
#
# Required: None (all have defaults)
# Recommended: Set REMEMBRA_OPENAI_API_KEY for LLM fact extraction
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
REMEMBRA_PORT=8787
REMEMBRA_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API Security
# -----------------------------------------------------------------------------
# Require API key for all requests (recommended for production)
REMEMBRA_REQUIRE_API_KEY=true

# CORS origins (comma-separated, or * for all)
REMEMBRA_CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
REMEMBRA_RATE_LIMIT_STORE=30/minute
REMEMBRA_RATE_LIMIT_RECALL=60/minute

# -----------------------------------------------------------------------------
# Embedding Model
# -----------------------------------------------------------------------------
# Embedding provider: openai, azure, ollama, cohere, voyage, jina
# REMEMBRA_EMBEDDING_PROVIDER=openai

# Local model (default, no API key needed):
REMEMBRA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Or use OpenAI embeddings (requires OPENAI_API_KEY):
# REMEMBRA_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# LLM models (optional; needs REMEMBRA_OPENAI_API_KEY below)
# -----------------------------------------------------------------------------
# Without an OpenAI key the LLM steps fall back: content is stored as split
# sentences and consolidation defaults to ADD. With one: LLM fact extraction,
# consolidation, entity recognition and matching.
#
# Which variable drives which task (the server logs "llm_task_models" once at
# startup with the model each task actually uses):
#
#   REMEMBRA_EXTRACTION_MODEL  fact extraction, consolidation (including the
#                              sleep-time pass), entity matching, conversation
#                              ingest, and entity extraction when the provider
#                              is openai. These calls always go to the OpenAI
#                              API, so this MUST be an OpenAI model. A Claude or
#                              Ollama model here is rejected by OpenAI and those
#                              steps fall back to their non-LLM defaults (a
#                              startup warning "extraction_model_not_openai"
#                              flags it).
#   REMEMBRA_LLM_PROVIDER      backend for entity extraction ONLY:
#                              openai | anthropic | ollama.
#   REMEMBRA_LLM_MODEL         entity-extraction model, used ONLY when
#                              REMEMBRA_EXTRACTION_MODEL does not fit
#                              REMEMBRA_LLM_PROVIDER (e.g. provider=anthropic).
#                              It never changes fact extraction or consolidation.
REMEMBRA_EXTRACTION_MODEL=gpt-4o-mini

# Entity extraction on Anthropic (everything else stays on OpenAI):
# REMEMBRA_LLM_PROVIDER=anthropic
# REMEMBRA_LLM_MODEL=claude-haiku-4-5
# REMEMBRA_ANTHROPIC_API_KEY=

# Entity extraction on a local Ollama (everything else stays on OpenAI):
# REMEMBRA_LLM_PROVIDER=ollama
# REMEMBRA_LLM_MODEL=llama3.1
# REMEMBRA_OLLAMA_URL=http://localhost:11434

# -----------------------------------------------------------------------------
# API Keys (for LLM/Embedding providers)
# -----------------------------------------------------------------------------
# Settings are read with the REMEMBRA_ prefix; a bare OPENAI_API_KEY is not
# read into settings (embeddings then fail with "REMEMBRA_OPENAI_API_KEY is required").
REMEMBRA_OPENAI_API_KEY=
REMEMBRA_ANTHROPIC_API_KEY=
REMEMBRA_VOYAGE_API_KEY=
REMEMBRA_JINA_API_KEY=

# -----------------------------------------------------------------------------
# Memory Defaults
# -----------------------------------------------------------------------------
# Default TTL for memories (leave empty for no expiration)
# Examples: 30 (30 days), 365 (1 year)
REMEMBRA_DEFAULT_TTL_DAYS=

# -----------------------------------------------------------------------------
# Qdrant Configuration
# -----------------------------------------------------------------------------
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# =============================================================================
# Advanced Configuration (rarely needed)
# =============================================================================

# Custom Qdrant URL (if not using docker-compose)
# REMEMBRA_QDRANT_URL=http://localhost:6333

# Qdrant collection name
# REMEMBRA_QDRANT_COLLECTION=memories

# Database URL (SQLite by default)
# REMEMBRA_DATABASE_URL=sqlite:////data/remembra.db
